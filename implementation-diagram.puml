@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #424242

package "Hardware" #ECEFF1 {
    [LDR Circuit] as hw_ldr #CFD8DC
    [Si7021] as hw_env #CFD8DC
    [MPU6050] as hw_imu #CFD8DC
    [GPS Module] as hw_gps #CFD8DC
    [Button B1] as hw_btn #CFD8DC
    [RGB LED] as hw_led #CFD8DC
}

package "Zephyr RTOS Application" #FAFAFA {
    
    folder "Acquisition threads (Producers)" #E8F5E9 {
        [ldr_sensor.c] as ldr_thread #A5D6A7
        [temp_hum_sensor.c] as temp_hum_thread #A5D6A7
        [imu_sensor.c] as imu_thread #A5D6A7
        [gps_sensor.c] as gps_thread #A5D6A7
    }

    folder "Communication (message queues)" #FFF8E1 {
        queue "ldr_msgq" as q_ldr #FFE082
        queue "env_msgq" as q_env #FFE082
        queue "imu_msgq" as q_imu #FFE082
        queue "gps_msgq" as q_gps #FFE082
    }

    folder "Core & telemetry (Consumers)" #E3F2FD {
        [main.c\n(FSM & Stats)] as main_thread #90CAF9
        
        database "Global Telemetry Struct\n(Protected by k_mutex)" as global_state #FFCC80
        
        [simu_telemetry.c] as simu_thread #90CAF9
    }
}

[ST-Link Virtual COM] as com_port #E0E0E0

' Hardware to Threads
hw_ldr --> ldr_thread : ADC
hw_env <--> temp_hum_thread : I2C
hw_imu <--> imu_thread : I2C
hw_gps --> gps_thread : UART (NMEA)
hw_btn --> main_thread : GPIO Interrupt

' Threads to Queues
ldr_thread --> q_ldr : Light %
temp_hum_thread --> q_env : Temp & hum
imu_thread --> q_imu : Accel, Gyro, Attitude
gps_thread --> q_gps : Lat, Lon, Alt, Fix

' Queues to Core (Only main consumes)
q_ldr --> main_thread
q_env --> main_thread
q_imu --> main_thread
q_gps --> main_thread

' Core to State to Simu
main_thread -l-> global_state : Updates state
global_state <-d- simu_thread : Reads data at 10Hz

' Core to Outputs
main_thread --> hw_led : GPIO (State Color)
simu_thread --> com_port : UART (SIMU)
main_thread --> com_port : UART (TEST/NORMAL Logs)

@enduml