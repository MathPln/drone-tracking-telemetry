@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #424242

package "Hardware" #ECEFF1 {
    [LDR Circuit] as hw_ldr #CFD8DC
    [Si7021] as hw_env #CFD8DC
    [MPU6050] as hw_imu #CFD8DC
    [GPS Module] as hw_gps #CFD8DC
    [Button B1] as hw_btn #CFD8DC
    [RGB LED] as hw_led #CFD8DC
}

package "Zephyr RTOS Application" #FAFAFA {
    
    folder "Acquisition threads (Producers)" #E8F5E9 {
        [ldr_sensor.c] as ldr_thread #A5D6A7
        [temp_hum_sensor.c] as temp_hum_thread #A5D6A7
        [mpu_sensor.c] as imu_thread #A5D6A7
        [gps_sensor.c] as gps_thread #A5D6A7
    }

    folder "Communication (Centralized)" #FFF8E1 {
        queue "sensor_msgq\n(struct sensor_message)" as q_central #FFE082
    }

    folder "Core & Telemetry (Consumer)" #E3F2FD {
        [main.c\n(FSM, Cache & Timers)] as main_thread #90CAF9
        
        [simu_protocol.c] as simu_protocol #90CAF9
        [statistics.c] as stats_module #90CAF9
        [rgb_led.c] as led_driver #90CAF9
    }
}

[ST-Link Virtual COM] as com_port #E0E0E0

' Hardware to Threads
hw_ldr --> ldr_thread : ADC
hw_env <--> temp_hum_thread : I2C
hw_imu <--> imu_thread : I2C
hw_gps --> gps_thread : UART (NMEA)
hw_btn --> main_thread : GPIO Interrupt

' Threads to Central Queue
ldr_thread --> q_central : MSG_SENSOR_LDR / FAULT
temp_hum_thread --> q_central : MSG_SENSOR_ENV / FAULT
imu_thread --> q_central : MSG_SENSOR_MPU / FAULT
gps_thread --> q_central : MSG_SENSOR_GPS / FAULT

' Timers inside Main Thread pushing to Queue
main_thread --> q_central : MSG_TIMER_TEST / NORMAL / SIMU

' Queue to Main Thread
q_central --> main_thread : Reads all messages

' Core Logic to Helpers
main_thread --> simu_protocol : Calls simu_build_frame()
main_thread --> stats_module : Updates & Prints stats
main_thread --> led_driver : Controls colors based on state

' Core to Outputs
led_driver --> hw_led : GPIO
main_thread --> com_port : UART (TEST/NORMAL/SIMU logs)

@enduml